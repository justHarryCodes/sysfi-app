# Copy to .env.local. NEXT_PUBLIC_* values are bundled into the browser.

# Backend API (same one the mobile app uses). Defaults to production.
NEXT_PUBLIC_BACKEND_URL=https://api.sysfi.network/api/v1

# Optional Alchemy key. Reads use public RPCs (lib/chains.js); Alchemy is only
# the fallback when they're slow or down, plus token discovery and transfer
# history (alchemy_* APIs). Enable every network you support on the Alchemy
# app (Arc must be switched on separately) and restrict the key to your web
# origins in the dashboard — browser keys are visible to anyone.
NEXT_PUBLIC_ALCHEMY_KEY=

# WalletConnect / Reown project id (public) — https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# End-to-end encrypted direct messages (/messages). Off until the backend has
# FEATURE_DMS=1 too — see ../docs/direct-messages.md.
NEXT_PUBLIC_FEATURE_DMS=
